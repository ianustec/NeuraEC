# Mailbox secrets. Do not commit real values.
# mailbox.json holds host, username and provider, never a password or token.

# provider=imap
NEURA_IMAP_PASSWORD=

# Gmail and Microsoft: clients live in ~/.neura/oauth.json,
# each mailbox's refresh token in <mailbox>.token.
# The variables below are only a fallback when that file is missing.
# provider=gmail
NEURA_GMAIL_CLIENT_ID=
NEURA_GMAIL_CLIENT_SECRET=
NEURA_GMAIL_REFRESH_TOKEN=

# provider=graph
NEURA_GRAPH_CLIENT_ID=
NEURA_GRAPH_REFRESH_TOKEN=
NEURA_GRAPH_TENANT=common
